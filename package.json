{
  "name": "node-red-contrib-viessmann",
  "version": "0.9.0",
  "description": "Node-RED module for integrating Viessmann devices via the official SaaS API",
  "scripts": {
    "test": "c8 mocha \"test/**/*_spec.js\"",
    "test:nocov": "mocha \"test/**/*_spec.js\"",
    "lint": "eslint .",
    "prepack": "npm run lint && npm test"
  },
  "files": [
    "nodes/",
    "examples/",
    "scripts/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "viessmann-get-tokens": "scripts/get-viessmann-tokens.js"
  },
  "keywords": [
    "node-red",
    "viessmann",
    "heating",
    "iot",
    "smart-home"
  ],
  "author": "Paweł Kot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkot/node-red-viessmann.git"
  },
  "node-red": {
    "nodes": {
      "viessmann-config": "nodes/viessmann-config.js",
      "viessmann-device-list": "nodes/viessmann-device-list.js",
      "viessmann-gateway-list": "nodes/viessmann-gateway-list.js",
      "viessmann-gateway-devices": "nodes/viessmann-gateway-devices.js",
      "viessmann-device-features": "nodes/viessmann-device-features.js",
      "viessmann-read": "nodes/viessmann-read.js",
      "viessmann-write": "nodes/viessmann-write.js"
    }
  },
  "dependencies": {
    "axios": "^1.16.1"
  },
  "//overrides": "Force fixed versions of transitive deps with published CVEs. All vulnerable paths are dev-only (mocha, node-red); patches do not change anything shipped to npm consumers. Each override is scoped to a major-range that matches what upstream uses, so a future ajv 8.x or body-parser 2.x doesn't break consumers' APIs. Revisit when upstream itself bumps these.",
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "ajv": "^6.14.0",
    "body-parser": "^1.20.3",
    "qs": "^6.15.2",
    "picomatch": "^4.0.4",
    "brace-expansion": "^2.0.3",
    "mocha": {
      "diff": "^8.0.3"
    },
    "express": {
      "path-to-regexp": "0.1.13"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^10.1.3",
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "nock": "^14.0.16",
    "node-red": "^4.1.10",
    "node-red-node-test-helper": "^0.3.6",
    "sinon": "^22.1.0"
  }
}
