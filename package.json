{
  "name": "node-red-contrib-viessmann",
  "version": "0.1.0",
  "description": "Node-RED module for integrating Viessmann devices via the official SaaS API",
  "scripts": {
    "test": "mocha \"test/**/*_spec.js\"",
    "lint": "eslint .",
    "prepack": "npm run lint && npm test"
  },
  "files": [
    "nodes/",
    "examples/",
    "scripts/",
    "LICENSE",
    "README.md",
    "FEATURES.md"
  ],
  "bin": {
    "viessmann-get-tokens": "scripts/get-viessmann-tokens.js"
  },
  "keywords": [
    "node-red",
    "viessmann",
    "heating",
    "iot",
    "smart-home"
  ],
  "author": "Paweł Kot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pkot/node-red-viessmann.git"
  },
  "node-red": {
    "nodes": {
      "viessmann-config": "nodes/viessmann-config.js",
      "viessmann-device-list": "nodes/viessmann-device-list.js",
      "viessmann-gateway-list": "nodes/viessmann-gateway-list.js",
      "viessmann-gateway-devices": "nodes/viessmann-gateway-devices.js",
      "viessmann-device-features": "nodes/viessmann-device-features.js",
      "viessmann-read": "nodes/viessmann-read.js",
      "viessmann-write": "nodes/viessmann-write.js"
    }
  },
  "dependencies": {
    "axios": "^1.16.1"
  },
  "//overrides": "Force fixed versions of transitive deps with published CVEs. All vulnerable paths are dev-only (mocha, node-red); patches do not change anything shipped to npm consumers. Revisit when upstream (node-red / mocha) bumps these themselves so the overrides can be removed.",
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "picomatch": ">=4.0.4",
    "ajv": ">=6.14.0",
    "brace-expansion": ">=2.0.3",
    "ip-address": ">=10.2.0",
    "qs": ">=6.15.2",
    "body-parser": ">=1.20.3",
    "diff": ">=8.0.3",
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "npm": {
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=2.0.3",
      "ip-address": ">=10.2.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.2.0",
    "eslint": "^10.0.0",
    "mocha": "^11.3.0",
    "nock": "^14.0.10",
    "node-red": "^4.1.10",
    "node-red-node-test-helper": "^0.3.5",
    "sinon": "^21.0.0"
  }
}
